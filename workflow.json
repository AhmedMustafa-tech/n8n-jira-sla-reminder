{
  "name": "Jira SLA reminders to Slack",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8-18 * * 1-5"
            }
          ]
        }
      },
      "name": "Every hour (business hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "a7ec1cd1-e544-4cdc-86e2-3a1aa4caebe8"
    },
    {
      "parameters": {
        "jsCode": "// ===== EDIT THESE =====\nreturn [{ json: {\n  jiraBaseUrl: 'https://YOUR-SITE.atlassian.net',\n  // JQL for open tickets you want to watch\n  jql: 'project = HELP AND statusCategory != Done ORDER BY created ASC',\n  // Custom field id of your JSM \"Time to resolution\" SLA (find it in Jira > Settings > Issues > Custom fields)\n  slaField: 'customfield_XXXXX',\n  // Send a heads-up when this many hours (or fewer) are left\n  warnHours: 4,\n  // Slack channel for breached tickets\n  escalationChannel: '#sla-escalations',\n}}];"
      },
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "58124760-3169-4a77-b919-0854c443c605"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.jiraBaseUrl }}/rest/api/3/search/jql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jql: $json.jql, maxResults: 100, fields: ['summary','status','assignee', $json.slaField] }) }}",
        "options": {}
      },
      "name": "Jira: search open tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "id": "34cd1c49-114f-49d3-b5d0-f04901d55acb"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst issues = $input.first().json.issues || [];\nconst out = [];\nfor (const it of issues) {\n  const f = it.fields || {};\n  const sla = f[cfg.slaField];\n  const cyc = sla && sla.ongoingCycle;\n  if (!cyc) continue;                                  // no running SLA clock\n  const email = f.assignee && f.assignee.emailAddress;\n  if (!email) continue;                                // unassigned: handled by triage, not DMs\n  const remH = cyc.remainingTime.millis / 3600000;\n  const breached = !!cyc.breached || remH < 0;\n  if (!breached && remH > cfg.warnHours) continue;     // healthy, nothing to do\n  out.push({ json: {\n    key: it.key,\n    summary: f.summary,\n    status: f.status && f.status.name,\n    assigneeEmail: email,\n    remainingHours: Math.round(remH * 10) / 10,\n    breached,\n    url: `${cfg.jiraBaseUrl}/browse/${it.key}`,\n    escalationChannel: cfg.escalationChannel,\n  }});\n}\nreturn out;"
      },
      "name": "Find at-risk & breached",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "97f79edd-2063-470b-97ab-896eb5ea8505"
    },
    {
      "parameters": {
        "url": "https://slack.com/api/users.lookupByEmail",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $json.assigneeEmail }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Slack: find assignee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "id": "c336cd04-9612-4aef-9466-c5ab7df4eb75"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.user.id, text: ($('Find at-risk & breached').item.json.breached ? ':rotating_light: *SLA breached*' : ':hourglass_flowing_sand: *SLA heads-up*') + ' \u2014 <' + $('Find at-risk & breached').item.json.url + '|' + $('Find at-risk & breached').item.json.key + '> ' + $('Find at-risk & breached').item.json.summary + '\\n' + ($('Find at-risk & breached').item.json.breached ? 'This ticket is past its SLA.' : $('Find at-risk & breached').item.json.remainingHours + 'h left on the clock.') }) }}",
        "options": {}
      },
      "name": "Slack: DM assignee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "id": "59041de1-535b-4bbc-9901-de1237b21413"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "3d68afbf-4f49-4b38-ace6-4508d6e8cfa5",
              "leftValue": "={{ $('Find at-risk & breached').item.json.breached }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
