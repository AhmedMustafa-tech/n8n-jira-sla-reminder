        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $('Find at-risk & breached').item.json.escalationChannel, text: ':rotating_light: Breached: <' + $('Find at-risk & breached').item.json.url + '|' + $('Find at-risk & breached').item.json.key + '> ' + $('Find at-risk & breached').item.json.summary + ' (owner: ' + $('Find at-risk & breached').item.json.assigneeEmail + ')' }) }}",
        "options": {}
